<Window x:Class="Nimbus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nimbus.Controls"
        Title="Nimbus" Width="1060" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource FgBrush}"
        Loaded="Window_Loaded">

  <!-- The window is a see-through stage. Shell is the visible Nimbus window inside it,
       so it can spring between the full window and the island pill at the top of the screen. -->
  <Canvas x:Name="Stage">
    <Border x:Name="Shell" Canvas.Left="20" Canvas.Top="20" Width="1020" Height="640"
            Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="22" SizeChanged="Shell_SizeChanged">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.45" Color="Black"/>
      </Border.Effect>

      <Grid x:Name="ShellGrid">
        <Grid.Clip>
          <RectangleGeometry x:Name="ShellClip" RadiusX="21" RadiusY="21" Rect="0,0,1018,638"/>
        </Grid.Clip>

        <!-- ================= Full window ================= -->
        <Grid x:Name="MainContent" Width="1018" Height="638" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Title bar (drag it to move the window) -->
          <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
              <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0"/>
              <TextBlock Text="Nimbus" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Flag}" Background="{StaticResource AccentBrush}" Margin="8,0,0,0">
                <TextBlock Text="V3" Style="{StaticResource FlagText}" Foreground="#120C2E"/>
              </Border>
              <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Background="#1A45D483">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource GoodBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="guarded" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource GoodBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="ModelDot" Width="7" Height="7" Fill="{StaticResource AceBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                  <TextBlock Text="lfm2.5-8b:latest" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="NetText" Text="{Binding NetText}" Style="{StaticResource MonoText}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
              <ToggleButton x:Name="RecButton" Content="Rec" Style="{StaticResource RecToggle}" ToolTip="Record" Click="RecButton_Click"/>
              <Button Style="{StaticResource IconButton}" ToolTip="Screenshot" Click="Camera_Click">
                <Path Data="M4,7 L7,7 L8.5,5 L15.5,5 L17,7 L20,7 L20,18 L4,18 Z M12,9.5 A3,3 0 1 0 12,15.5 A3,3 0 1 0 12,9.5 Z"
                      Stroke="{StaticResource FgBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
              <Button x:Name="GearButton" Style="{StaticResource IconButton}" ToolTip="Settings" Click="Gear_Click">
                <TextBlock Text="⚙" FontSize="16" Margin="0,-2,0,0"/>
              </Button>
              <Button Style="{StaticResource IconButton}" ToolTip="Shrink to the island" Click="Collapse_Click">
                <Path Data="M6,15 L12,9 L18,15" Stroke="{StaticResource FgBrush}" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource DismissButton}" ToolTip="Close" Click="Close_Click" Margin="2,0,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Sidebar + pages -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="NavArea" Margin="14,4,8,14" VerticalAlignment="Top">
              <!-- The highlight that springs between tabs -->
              <Border x:Name="NavIndicator" Height="38" VerticalAlignment="Top" CornerRadius="12"
                      Background="{StaticResource AccentSoftBrush}" BorderBrush="#598F7CFF" BorderThickness="1">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="NavShift" Y="0"/>
                </Border.RenderTransform>
                <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Left" Margin="5,0,0,0"/>
              </Border>
              <StackPanel x:Name="NavList">
                <RadioButton x:Name="NavGlance" Style="{StaticResource NavTab}" Tag="glance" Content="Glance" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="ace" Content="Ace" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="scripts" Content="Scripts" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="calendar" Content="Calendar" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="alerts" Checked="Nav_Checked">
                  <DockPanel LastChildFill="False">
                    <TextBlock Text="Alerts" DockPanel.Dock="Left"/>
                    <Border x:Name="AlertBadge" DockPanel.Dock="Right" Background="{StaticResource NovaBrush}" CornerRadius="9"
                            MinWidth="20" Height="18" Padding="5,0" RenderTransformOrigin="0.5,0.5">
                      <TextBlock x:Name="AlertBadgeText" Text="4" FontSize="11" FontWeight="ExtraBold" Foreground="#2A0712"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </DockPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavTab}" Tag="audio" Content="Audio" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="clips" Content="Clips" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="memory" Content="Memory" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="games" Content="Games" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource NavTab}" Tag="orbit" Content="◎  Orbit" Checked="Nav_Checked"/>
              </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="4,2,16,16" Focusable="False"/>
          </Grid>

          <!-- White flash for the screenshot button -->
          <Border x:Name="Flash" Grid.RowSpan="2" Background="White" Opacity="0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ================= Island pill ================= -->
        <Grid x:Name="IslandContent" Visibility="Collapsed" Opacity="0" Background="Transparent" Cursor="Hand"
              MouseLeftButtonUp="Island_MouseLeftButtonUp" ToolTip="Open Nimbus">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="9" Margin="9,0,10,0" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5F8F" Offset="0"/>
                <GradientStop Color="#8F7CFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="IslandTitle" Text="You Do Not Need A New Phone" FontSize="13" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="IslandArtist" Text="snoozie" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <c:WaveBars x:Name="IslandWave" Grid.Column="2" Bars="8" BarHeight="18" Margin="10,0,18,0" VerticalAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>
  </Canvas>
</Window>
