<UserControl x:Class="Nimbus.Controls.CrewBuddy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Pebble, Nova or Ace: a blob that blinks, jumps when you click it and sweats when things run hot. -->
  <StackPanel HorizontalAlignment="Center">
    <Grid x:Name="Body" Width="44" Height="40" Background="Transparent" Cursor="Hand"
          MouseLeftButtonUp="Body_MouseLeftButtonUp">
      <Border x:Name="Blob" CornerRadius="20,20,15,15" Background="{StaticResource PebbleBrush}">
        <Border Height="12" Margin="7,3,7,0" VerticalAlignment="Top" CornerRadius="6" Background="#40FFFFFF"/>
      </Border>
      <StackPanel x:Name="Eyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Margin="0,2,0,0" RenderTransformOrigin="0.5,0.5">
        <StackPanel.RenderTransform>
          <ScaleTransform x:Name="EyeScale" ScaleX="1" ScaleY="1"/>
        </StackPanel.RenderTransform>
        <Ellipse Width="6" Height="8" Margin="3,0" Fill="#14121F"/>
        <Ellipse Width="6" Height="8" Margin="3,0" Fill="#14121F"/>
      </StackPanel>
      <Path x:Name="Sweat" Data="M4,0 C4,0 8,6 8,9 A4,4 0 1 1 0,9 C0,6 4,0 4,0 Z" Fill="#7FD3FF"
            Width="8" Height="13" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,-4,-3,0" Visibility="Collapsed"/>
    </Grid>
    <TextBlock x:Name="NameBlock" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11" FontWeight="ExtraBold"
               Foreground="{StaticResource MutedBrush}"/>
  </StackPanel>
</UserControl>
