<UserControl x:Class="Nimbus.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A Glance tile: label, big number, and a bar that springs to its new length. -->
  <Border x:Name="Card" Style="{StaticResource Tile}">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="LabelBlock" Style="{StaticResource LabelText}"/>
        <Border x:Name="FlagPill" Style="{StaticResource Flag}" Margin="6,0,0,0" Visibility="Collapsed">
          <TextBlock x:Name="FlagBlock" Style="{StaticResource FlagText}"/>
        </Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,2,0,7">
        <TextBlock x:Name="ValueBlock" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold"
                   Foreground="{StaticResource FgBrush}" RenderTransformOrigin="0,1"/>
        <TextBlock x:Name="UnitBlock" Margin="3,0,0,6" VerticalAlignment="Bottom" FontSize="13" FontWeight="Bold"
                   Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <Border Style="{StaticResource BarTrack}" Height="6" CornerRadius="3">
        <Border x:Name="Fill" CornerRadius="3" Background="{StaticResource GoodBrush}" RenderTransformOrigin="0,0.5">
          <Border.RenderTransform>
            <ScaleTransform x:Name="FillScale" ScaleX="0" ScaleY="1"/>
          </Border.RenderTransform>
        </Border>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
