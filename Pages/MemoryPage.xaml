<UserControl x:Class="Nimbus.Pages.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel x:Name="Root" Margin="0,4,8,0">

      <!-- Committed (real numbers) -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Style="{StaticResource LabelText}">
            <Run Text="COMMITTED"/><Run Text="  (what Windows has promised to apps)" FontWeight="SemiBold"/>
          </TextBlock>
          <TextBlock Text="{Binding CommitLine}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8"/>
          <Border Style="{StaticResource BarTrack}">
            <Border x:Name="CommitFill" CornerRadius="5" Background="{StaticResource GoodBrush}" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="CommitScale" ScaleX="0"/>
              </Border.RenderTransform>
            </Border>
          </Border>
          <TextBlock x:Name="CommitNote" Margin="0,8,0,0" Style="{StaticResource BodyText}" Foreground="{StaticResource AmberBrush}"
                     Text="Getting full: a game plus clips and models may start to page." Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <!-- RAM (real numbers) -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="RAM" Style="{StaticResource LabelText}"/>
          <TextBlock Text="{Binding RamLine}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,8"/>
          <Border Style="{StaticResource BarTrack}">
            <Border CornerRadius="5" Background="{StaticResource GoodBrush}" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="RamScale" ScaleX="0"/>
              </Border.RenderTransform>
            </Border>
          </Border>
        </StackPanel>
      </Border>

      <!-- Auto trim -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="AUTO TRIM" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="KeepText" Margin="0,4,0,2" FontWeight="ExtraBold" Foreground="{StaticResource PinkTextBrush}" Text="Keeping 20.0 GB free"/>
          <TextBlock x:Name="GaveBack" Style="{StaticResource BodyText}" Text="Trim an app below to give its unused memory back."/>
          <DockPanel Margin="0,10,0,6">
            <TextBlock DockPanel.Dock="Left" Text="Keep free" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="KeepValue" DockPanel.Dock="Right" Text="20.0 GB" Style="{StaticResource MonoText}" Width="64" TextAlignment="Right"/>
            <Slider x:Name="KeepFree" Style="{StaticResource NimbusSlider}" Minimum="4" Maximum="28" Value="20"
                    SmallChange="0.5" LargeChange="2" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="KeepFree_ValueChanged"/>
          </DockPanel>
          <Canvas x:Name="Graph" Height="74" ClipToBounds="True" SizeChanged="Graph_SizeChanged">
            <Polygon x:Name="GraphFill" Fill="#2645D483"/>
            <Polyline x:Name="GraphLine" Stroke="{StaticResource GoodBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            <Line x:Name="TargetLine" Stroke="{StaticResource PinkTextBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" X1="0" Y1="20" Y2="20"/>
          </Canvas>
          <TextBlock Style="{StaticResource BodyText}" FontSize="11.5" Margin="0,6,0,0"
                     Text="Free RAM over the last 40 seconds. The dashed line is the keep-free target; the line glows when free RAM drops under it."/>
        </StackPanel>
      </Border>

      <!-- Apps (real list) -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SmallPillButton}" Margin="0" Click="Refresh_Click"/>
            <TextBlock Text="APPS, BY MEMORY COMMITTED" Style="{StaticResource LabelText}"/>
          </DockPanel>
          <ItemsControl x:Name="AppList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="ExtraBold"/>
                    <Run Text="{Binding CountText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontWeight="Bold"/>
                  </TextBlock>
                  <TextBlock Grid.Column="1" Text="{Binding CommitText}" Style="{StaticResource MonoText}" TextAlignment="Right"/>
                  <TextBlock x:Name="RamText" Grid.Column="2" Text="{Binding RamText}" Style="{StaticResource MonoText}"
                             Foreground="{StaticResource MutedBrush}" TextAlignment="Right" Margin="0,0,10,0"/>
                  <Button Grid.Column="3" Content="Trim" Style="{StaticResource SmallPillButton}" Click="Trim_Click"/>
                  <Button Grid.Column="4" Content="{Binding CloseLabel}" Style="{StaticResource SmallPillButton}" Margin="0"
                          Visibility="{Binding HasWindow, Converter={StaticResource BoolToVis}}" Click="Close_Click"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
