<UserControl x:Class="Nimbus.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nimbus.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel x:Name="Root" Margin="0,4,8,0">

      <!-- Now playing -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel>
            <Border Width="78" Height="78" CornerRadius="16" Margin="0,0,14,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF5F8F" Offset="0"/>
                  <GradientStop Color="#8F7CFF" Offset="0.6"/>
                  <GradientStop Color="#5BB6FF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="NOW PLAYING" Style="{StaticResource LabelText}" Foreground="{StaticResource AmberBrush}"/>
              <TextBlock x:Name="TrackTitle" Text="You Do Not Need A New Phone" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="TrackArtist" Text="snoozie" Style="{StaticResource SubText}"/>
              <c:WaveBars x:Name="Wave" Bars="22" BarHeight="24" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,12,0,0">
            <TextBlock x:Name="CurText" DockPanel.Dock="Left" Text="3:08" Style="{StaticResource MonoText}" Width="40"/>
            <TextBlock x:Name="LenText" DockPanel.Dock="Right" Text="5:59" Style="{StaticResource MonoText}" Width="40" TextAlignment="Right"/>
            <Border Style="{StaticResource BarTrack}" Height="6" CornerRadius="3">
              <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource PinkTextBrush}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="ProgressScale" ScaleX="0.52" ScaleY="1"/>
                </Border.RenderTransform>
              </Border>
            </Border>
          </DockPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Style="{StaticResource RoundButton}" ToolTip="Previous" Click="Prev_Click">
              <Path Data="M6,5 L6,19 M19,5 L9,12 L19,19 Z" Fill="{StaticResource FgBrush}" Stroke="{StaticResource FgBrush}" StrokeThickness="2" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
            </Button>
            <Button x:Name="PlayButton" Style="{StaticResource RoundButton}" Width="56" Height="56" Background="{StaticResource FgBrush}" ToolTip="Pause" Click="Play_Click">
              <Path x:Name="PlayIcon" Data="M6.5,4.5 L10.5,4.5 L10.5,19.5 L6.5,19.5 Z M13.5,4.5 L17.5,4.5 L17.5,19.5 L13.5,19.5 Z" Fill="{StaticResource InkBrush}" Width="18" Height="18" Stretch="Uniform"/>
            </Button>
            <Button Style="{StaticResource RoundButton}" ToolTip="Next" Click="Next_Click">
              <Path Data="M18,5 L18,19 M5,5 L15,12 L5,19 Z" Fill="{StaticResource FgBrush}" Stroke="{StaticResource FgBrush}" StrokeThickness="2" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Master volume and output -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel>
            <Button x:Name="MasterMute" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="🔊" FontSize="13" ToolTip="Mute everything" Click="MasterMute_Click"/>
            <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{Binding Value, ElementName=MasterVolume, StringFormat={}{0:0}%}"/>
            <Slider x:Name="MasterVolume" Style="{StaticResource NimbusSlider}" Value="100" Margin="8,0"/>
          </DockPanel>
          <TextBlock Text="OUTPUT" Style="{StaticResource LabelText}" Margin="0,12,0,6"/>
          <WrapPanel>
            <RadioButton Content="Speakers" GroupName="AudioOut" Style="{StaticResource FilterChip}" Checked="Output_Checked"/>
            <RadioButton Content="Headphones (Logi Z207)" GroupName="AudioOut" IsChecked="True" Style="{StaticResource FilterChip}" Checked="Output_Checked"/>
            <RadioButton Content="Sceptre F24" GroupName="AudioOut" Style="{StaticResource FilterChip}" Checked="Output_Checked"/>
            <RadioButton Content="Sceptre T24" GroupName="AudioOut" Style="{StaticResource FilterChip}" Checked="Output_Checked"/>
            <RadioButton Content="Digital Audio" GroupName="AudioOut" Style="{StaticResource FilterChip}" Checked="Output_Checked"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Per-app mixer -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="APPS" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
          <ItemsControl x:Name="AppList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="28" Height="28" CornerRadius="9" Background="{Binding Color}" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Letter}" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" FontSize="13"/>
                    <!-- little live level meter -->
                    <Border Height="3" Width="70" HorizontalAlignment="Left" Margin="0,4,0,0" CornerRadius="1.5" Background="#1AFFFFFF" ClipToBounds="True">
                      <Border x:Name="Level" CornerRadius="1.5" Background="{StaticResource GoodBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                          <ScaleTransform ScaleX="0.3"/>
                        </Border.RenderTransform>
                      </Border>
                    </Border>
                  </StackPanel>
                  <Slider Grid.Column="2" Style="{StaticResource NimbusSlider}" Value="{Binding Volume, Mode=TwoWay}" Margin="4,0,10,0"/>
                  <TextBlock Grid.Column="3" Style="{StaticResource MonoText}" Text="{Binding Volume, StringFormat={}{0:0}%}"/>
                  <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="{Binding MuteIcon}" FontSize="12" Margin="0" ToolTip="Mute" Click="AppMute_Click"/>
                </Grid>
                <DataTemplate.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="Level" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.15" To="0.85" Duration="0:0:0.55"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                  <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="Level" Property="Visibility" Value="Hidden"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
