<UserControl x:Class="Nimbus.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="0,4,0,0">
    <TextBox x:Name="Search" DockPanel.Dock="Top" Style="{StaticResource PillTextBox}" Tag="Search settings"
             Margin="0,0,8,12" TextChanged="Search_TextChanged"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel x:Name="Root" Margin="0,0,8,0">

        <!-- Motion (new): the bounce slider -->
        <Border x:Name="MotionRow" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,8" Tag="Motion bounce animation">
          <StackPanel>
            <Button Style="{StaticResource FlatRowButton}" Click="Head_Click">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="{StaticResource MutedBrush}" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Motion" FontWeight="ExtraBold" FontSize="14"/>
                  <Border Style="{StaticResource Flag}" Background="{StaticResource AceBrush}" Margin="8,0,0,0">
                    <TextBlock Text="New" Style="{StaticResource FlagText}" Foreground="#06203A"/>
                  </Border>
                </StackPanel>
              </DockPanel>
            </Button>
            <StackPanel Visibility="Collapsed" Margin="14,0,14,12">
              <TextBlock Style="{StaticResource BodyText}" Text="How bouncy Nimbus feels. Try it, then click the tabs."/>
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Calm" Style="{StaticResource LabelText}" Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Right" Text="Boing" Style="{StaticResource LabelText}" Margin="10,0,0,0"/>
                <Slider x:Name="BounceSlider" Style="{StaticResource NimbusSlider}" Value="61" ValueChanged="Bounce_ValueChanged"/>
              </DockPanel>
              <CheckBox x:Name="MotionOn" Style="{StaticResource ToggleSwitch}" Content="Animations on" IsChecked="True" Margin="0,10,0,0"
                        Checked="MotionOn_Changed" Unchecked="MotionOn_Changed"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Island -->
        <Border Style="{StaticResource Card}" Padding="4" Margin="0,0,0,8" Tag="Island now playing pill top">
          <StackPanel>
            <Button Style="{StaticResource FlatRowButton}" Click="Head_Click">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="{StaticResource MutedBrush}" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="Island" FontWeight="ExtraBold" FontSize="14"/>
              </DockPanel>
            </Button>
            <StackPanel Visibility="Collapsed" Margin="14,0,14,12">
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Show what's playing in the island" IsChecked="True" Margin="0,0,0,8"/>
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Keep the island on top of other windows" IsChecked="True"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- The rest of the rows are added in code (SettingsPage.xaml.cs) -->
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
