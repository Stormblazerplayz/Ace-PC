<UserControl x:Class="Nimbus.Pages.OrbitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design guess: Orbit is an agent runtime that works on its own PC (a VM).
       Everything here is simulated; wire the buttons to your real Orbit code. -->
  <Grid x:Name="Root" Margin="0,4,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
      <Border DockPanel.Dock="Left" Style="{StaticResource IconBadge}" Width="46" Height="46" Margin="0,0,12,0">
        <TextBlock Text="◎" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
      </Border>
      <Border x:Name="StateFlag" DockPanel.Dock="Right" Style="{StaticResource Flag}" Background="{StaticResource GoodBrush}">
        <TextBlock x:Name="StateFlagText" Text="Runtime running" Style="{StaticResource FlagText}" Foreground="#06240F"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Orbit" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Agent runtime with its own PC" Style="{StaticResource SubText}"/>
      </StackPanel>
    </DockPanel>

    <!-- Setup checklist -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,10,0" VerticalAlignment="Top">
      <StackPanel>
        <TextBlock Text="ORBIT PC" Style="{StaticResource LabelText}"/>
        <TextBlock x:Name="PcState" Text="Needs setup" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,10"/>

        <DockPanel Margin="0,0,0,8">
          <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource GoodBrush}" Margin="0,0,10,0">
            <TextBlock Text="✓" FontWeight="ExtraBold" Foreground="#06240F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Runtime is running" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <DockPanel Margin="0,0,0,6">
          <Border x:Name="ImageCheck" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" BorderBrush="#40FFFFFF" BorderThickness="2" Margin="0,0,10,0">
            <TextBlock x:Name="ImageTick" Text="✓" FontWeight="ExtraBold" Foreground="#06240F" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
          </Border>
          <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy over" Style="{StaticResource SmallPillButton}" Margin="0" Click="Copy_Click"/>
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap">
            <Run Text="60 GB disk image"/><Run Text=" (on Lightning)" Foreground="{StaticResource MutedBrush}"/>
          </TextBlock>
        </DockPanel>
        <Border x:Name="CopyTrack" Style="{StaticResource BarTrack}" Height="8" Margin="32,0,0,10" Visibility="Collapsed">
          <Border CornerRadius="4" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform x:Name="CopyScale" ScaleX="0"/>
            </Border.RenderTransform>
          </Border>
        </Border>

        <DockPanel>
          <Border x:Name="ModelCheck" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" BorderBrush="#40FFFFFF" BorderThickness="2" Margin="0,0,10,0">
            <TextBlock x:Name="ModelTick" Text="✓" FontWeight="ExtraBold" Foreground="#06240F" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
          </Border>
          <Button x:Name="ModelButton" DockPanel.Dock="Right" Content="Use lfm2.5-8b" Style="{StaticResource SmallPillButton}" Margin="0" Click="Model_Click"/>
          <TextBlock Text="A model for Orbit to think with" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Jobs + activity -->
    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="GIVE ORBIT A JOB" Style="{StaticResource LabelText}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,8,0,6">
          <Button x:Name="StartButton" DockPanel.Dock="Right" Content="Start" Style="{StaticResource HotPillButton}" Margin="8,0,0,0" IsEnabled="False" Click="Start_Click"/>
          <TextBox x:Name="JobInput" Style="{StaticResource PillTextBox}" Tag="Like: tidy my Downloads folder" KeyDown="JobInput_KeyDown"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}" FontSize="12" Text="Orbit works on its own PC, not yours. It starts once setup is done."/>
        <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Style="{StaticResource LabelText}" Margin="0,12,0,6"/>
        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel x:Name="LogList"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
