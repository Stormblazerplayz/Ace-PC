<UserControl x:Class="Nimbus.Pages.GlancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nimbus.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The crew -->
    <StackPanel Margin="0,18,10,0">
      <c:CrewBuddy x:Name="Pebble" Label="Pebble" BuddyBrush="{StaticResource PebbleBrush}" IsHot="{Binding CpuHot}" Margin="0,0,0,16"/>
      <c:CrewBuddy x:Name="Nova" Label="Nova" BuddyBrush="{StaticResource NovaBrush}" Margin="0,0,0,16"/>
      <c:CrewBuddy x:Name="AceBuddy" Label="Ace" BuddyBrush="{StaticResource AceBrush}"/>
    </StackPanel>

    <StackPanel x:Name="Root" Grid.Column="1">
      <StackPanel>
        <TextBlock x:Name="ClockText" Text="2:42 PM" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource SubText}">
          <Run x:Name="DateRun" Text="Thursday, October 29"/>
          <Run Text=" · "/>
          <Run Text="{Binding Uptime, Mode=OneWay}"/>
        </TextBlock>
        <!-- Sample weather line: hook your weather code to WeatherText.Text -->
        <TextBlock x:Name="WeatherText" Style="{StaticResource SubText}" Margin="0,2,0,0" Text="☀ 74°F, mainly clear · humidity 54% · wind 6 mph"/>
      </StackPanel>

      <UniformGrid Columns="4" Rows="2" Margin="-4,14,-4,0">
        <c:StatTile Margin="4" Label="Disk free · C:" Unit="GB" Value="{Binding DiskText}" Percent="{Binding DiskUsedPercent}"
                    Flag="{Binding DiskFlag}" IsWarn="{Binding DiskLow}"/>
        <c:StatTile Margin="4" Label="CPU" Unit="%" Value="{Binding CpuText}" Percent="{Binding Cpu}"/>
        <c:StatTile Margin="4" Label="Memory" Unit="%" Value="{Binding MemText}" Percent="{Binding MemPercent}"/>
        <c:StatTile Margin="4" Label="GPU" Unit="%" Value="{Binding GpuText}" Percent="{Binding GpuPercent}" BarBrush="{StaticResource AccentBrush}"/>
        <c:StatTile Margin="4" Label="CPU temp" Unit="°C" Value="{Binding CpuTempText}" Percent="{Binding CpuTempPercent}"
                    BarBrush="{StaticResource PebbleBrush}" Flag="{Binding SensorFlag}" IsWarn="{Binding CpuHot}"/>
        <c:StatTile Margin="4" Label="GPU temp" Unit="°C" Value="{Binding GpuTempText}" Percent="{Binding GpuTempPercent}" BarBrush="{StaticResource PebbleBrush}"/>
        <c:StatTile Margin="4" Label="Fans" Unit="rpm" Value="{Binding FanText}" Percent="{Binding FanPercent}" BarBrush="{StaticResource AceBrush}"/>
        <!-- Download tile with a sparkline -->
        <Border Margin="4" Style="{StaticResource Tile}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Download" Style="{StaticResource LabelText}"/>
              <TextBlock Margin="6,0,0,0" Style="{StaticResource MonoText}" FontSize="10" Foreground="{StaticResource MutedBrush}">
                <Run Text="{Binding DownText, Mode=OneWay}"/><Run Text=" MB/s"/>
              </TextBlock>
            </StackPanel>
            <Canvas x:Name="SparkBox" Height="44" Margin="0,8,0,0" ClipToBounds="True" SizeChanged="SparkBox_SizeChanged">
              <Polygon x:Name="SparkFill" Fill="#268F7CFF"/>
              <Polyline x:Name="SparkLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
            </Canvas>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Action buttons, sorted into rows -->
      <StackPanel Margin="0,12,0,0">
        <DockPanel Margin="0,0,0,7">
          <TextBlock Text="SYSTEM" Width="58" Style="{StaticResource LabelText}"/>
          <WrapPanel>
            <Button Content="Lock" Style="{StaticResource SmallPillButton}" Click="Lock_Click"/>
            <Button Content="AFK" Style="{StaticResource SmallPillButton}"/>
            <Button Content="Keep awake" Style="{StaticResource SmallPillButton}"/>
            <Button Content="Task Mgr" Style="{StaticResource SmallPillButton}" Tag="taskmgr.exe" Click="Launch_Click"/>
            <Button Content="Processes" Style="{StaticResource SmallPillButton}" Tag="memory" Click="Tab_Click"/>
            <Button Content="Wi-Fi" Style="{StaticResource SmallPillButton}" Tag="ms-settings:network-wifi" Click="Launch_Click"/>
          </WrapPanel>
        </DockPanel>
        <DockPanel Margin="0,0,0,7">
          <TextBlock Text="TOOLS" Width="58" Style="{StaticResource LabelText}"/>
          <WrapPanel>
            <Button Content="Record" Style="{StaticResource SmallPillButton}" Tag="clips" Click="Tab_Click"/>
            <Button Content="Snip" Style="{StaticResource SmallPillButton}" Tag="ms-screenclip:" Click="Launch_Click"/>
            <Button Content="Code" Style="{StaticResource SmallPillButton}"/>
            <Button Content="Downloads" Style="{StaticResource SmallPillButton}" Click="Downloads_Click"/>
            <Button Content="Empty Bin" Style="{StaticResource SmallPillButton}"/>
            <Button Content="Sound" Style="{StaticResource SmallPillButton}" Tag="ms-settings:sound" Click="Launch_Click"/>
          </WrapPanel>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="AI" Width="58" Style="{StaticResource LabelText}"/>
          <WrapPanel>
            <Button x:Name="PauseAi" Content="Pause AI" Style="{StaticResource HotPillButton}" Padding="10,4" FontSize="11" Click="PauseAi_Click"/>
            <Button Content="Clear alerts" Style="{StaticResource SmallPillButton}" Click="ClearAlerts_Click"/>
            <Button Content="Settings" Style="{StaticResource SmallPillButton}" Tag="settings" Click="Tab_Click"/>
          </WrapPanel>
        </DockPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
