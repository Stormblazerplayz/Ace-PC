<UserControl x:Class="Nimbus.Pages.AceChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="232"/>
    </Grid.ColumnDefinitions>

    <!-- Top buttons -->
    <WrapPanel Grid.ColumnSpan="2" Margin="0,4,0,10">
      <Button Content="+ New" Style="{StaticResource SmallPillButton}" Click="New_Click"/>
      <Button Content="Web" Style="{StaticResource SmallPillButton}"/>
      <Button Content="Controls" Style="{StaticResource SmallPillButton}"/>
      <Button Content="History" Style="{StaticResource SmallPillButton}"/>
      <Button Content="Models" Style="{StaticResource SmallPillButton}"/>
    </WrapPanel>

    <!-- Chat -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,10,0" Padding="0">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Margin="12" Padding="6" CornerRadius="99" Background="#14FFFFFF"
                BorderBrush="#1FFFFFFF" BorderThickness="1.5">
          <DockPanel>
            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0"
                    Background="{StaticResource AccentBrush}" Click="Send_Click" ToolTip="Send">
              <Path Data="M12,19 L12,6 M6,11 L12,5 L18,11" Stroke="#120C2E" StrokeThickness="2.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"/>
            </Button>
            <Button x:Name="MicButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="Mic_Click"
                    ToolTip="Talk to Ace: tap, talk, tap again">
              <Path x:Name="MicIcon" Data="M12,3 A3,3 0 0 1 15,6 L15,12 A3,3 0 0 1 9,12 L9,6 A3,3 0 0 1 12,3 Z M6,11 A6,6 0 0 0 18,11 M12,17 L12,21"
                    Stroke="{StaticResource FgBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Width="14" Height="15" Stretch="Uniform"/>
            </Button>
            <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource IconButton}" Click="Attach_Click"
                    ToolTip="Attach a picture (png, jpg, webp) or a sound clip (wav, mp3)"/>
            <TextBox x:Name="Input" Style="{StaticResource PillTextBox}" Background="Transparent" BorderThickness="0"
                     Tag="Message Ace  ·  / for commands" KeyDown="Input_KeyDown"/>
          </DockPanel>
        </Border>
        <!-- Shows what's attached to the next message -->
        <Border x:Name="AttachChip" DockPanel.Dock="Bottom" Visibility="Collapsed" HorizontalAlignment="Left"
                Margin="16,0,0,0" Padding="12,5,6,5" CornerRadius="99" Background="#14FFFFFF">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="AttachText" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="✕" Style="{StaticResource BareButton}" Margin="8,0,0,0" Padding="4,0" FontSize="11"
                    Foreground="{StaticResource MutedBrush}" Click="ClearAttach_Click" ToolTip="Remove"/>
          </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,0,0,0">
          <Ellipse Width="12" Height="12" Stroke="{StaticResource AmberBrush}" StrokeThickness="2"
                   StrokeDashArray="3 2" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="SpinTurn"/>
            </Ellipse.RenderTransform>
          </Ellipse>
          <TextBlock Text="Work for…" Margin="8,0,0,0" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
        </StackPanel>
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="14,14,14,6">
          <StackPanel x:Name="ChatList"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Model, training list and the team -->
    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="MODEL" Style="{StaticResource LabelText}"/>
        <Border Margin="0,6,0,12" Padding="12,8" CornerRadius="12" Background="#14FFFFFF">
          <StackPanel>
            <TextBlock x:Name="ModelName" Text="LFM3 Omni 2B" FontWeight="ExtraBold"/>
            <TextBlock x:Name="ModelDetail" Text="not started" Margin="0,2,0,0" FontSize="11.5" FontWeight="Bold"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="TRAINING AND PLANNED" Style="{StaticResource LabelText}"/>
        <StackPanel Margin="0,6,0,10">
          <DockPanel Margin="0,0,0,5"><TextBlock DockPanel.Dock="Right" Text="paused" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Tiny 1.2" FontWeight="Bold"/></DockPanel>
          <DockPanel Margin="0,0,0,5"><TextBlock DockPanel.Dock="Right" Text="planned" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Tiny 1.3" FontWeight="Bold"/></DockPanel>
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="planned" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Spark One" FontWeight="Bold"/></DockPanel>
        </StackPanel>
        <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1">
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="All models on this PC" FontWeight="Bold" FontSize="12.5"/></DockPanel>
        </Border>
        <TextBlock Text="RUN ON" Style="{StaticResource LabelText}"/>
        <WrapPanel Margin="0,6,0,8">
          <RadioButton x:Name="RunGpu" Content="⚡ GPU" GroupName="AceRunOn" IsChecked="True" Style="{StaticResource FilterChip}"
                       Checked="RunOn_Checked"/>
          <RadioButton x:Name="RunCpu" Content="CPU+RAM" GroupName="AceRunOn" Style="{StaticResource FilterChip}"
                       Checked="RunOn_Checked"/>
        </WrapPanel>
        <TextBlock Text="TEAM" Style="{StaticResource LabelText}"/>
        <UniformGrid Columns="3" Margin="0,8,0,0">
          <Button Style="{StaticResource BareButton}" Tag="Slate" Click="Mate_Click">
            <StackPanel>
              <Border x:Name="SlateFace" Width="40" Height="40" CornerRadius="20" Background="#7D97E0">
                <TextBlock Text="S" FontWeight="ExtraBold" FontSize="16" Foreground="#14121F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Slate" Margin="0,4,0,0" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BareButton}" Tag="Scout" Click="Mate_Click">
            <StackPanel>
              <Border x:Name="ScoutFace" Width="40" Height="40" CornerRadius="20" Background="#3FC47E">
                <TextBlock Text="S" FontWeight="ExtraBold" FontSize="16" Foreground="#14121F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Scout" Margin="0,4,0,0" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource BareButton}" Tag="Forge" Click="Mate_Click">
            <StackPanel>
              <Border x:Name="ForgeFace" Width="40" Height="40" CornerRadius="20" Background="#F2733A">
                <TextBlock Text="F" FontWeight="ExtraBold" FontSize="16" Foreground="#14121F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="Forge" Margin="0,4,0,0" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
